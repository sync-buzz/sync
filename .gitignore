# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sync project memory (local only)
/.sync

# Bundled memory engine — a build artifact of ../memory-hub, not source
/src-tauri/binaries/

# Nothing here needs one — the manifest pins the engine to a tag and a clean
# checkout builds from it. Ignored anyway, so that a `[patch]` written while
# working on the engine next door cannot be committed by accident: a file in
# this repository must not require a directory that is not part of it.
src-tauri/.cargo/

# Agent connections this project's own Agents section writes. Each names the
# sidecar by absolute path, so it is true on one machine and wrong on every
# other one — a connection is made per checkout, not shared through the repo.
/.mcp.json
/.cursor/mcp.json
/.vscode/mcp.json

# Declarations emitted only so API Extractor can read them. The artefact worth
# keeping is `api/extension-api.api.md`, which is committed; this is the scrap
# it was derived from.
/temp/
